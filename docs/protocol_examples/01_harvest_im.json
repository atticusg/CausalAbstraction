{
  "version": "1",
  "description": "Activation harvesting: pure reads at two layers x two positions, one un-intervened forward. No edits, hence no intervened_models section.",
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main"},
  "data": {
    "base": {"dataset": "weekdays/train", "field": "input"}
  },
  "positions": {
    "answer_tok": {"index": -1},
    "subject":    {"variable": "subject"}
  },
  "sites": {
    "L8":  {"component": "block_output", "layer": 8},
    "L24": {"component": "block_output", "layer": 24}
  },
  "reads": {
    "acts_L8_ans":  {"site": "L8",  "pos": "answer_tok", "model": "original", "input": "base"},
    "acts_L8_sub":  {"site": "L8",  "pos": "subject",    "model": "original", "input": "base"},
    "acts_L24_ans": {"site": "L24", "pos": "answer_tok", "model": "original", "input": "base"},
    "acts_L24_sub": {"site": "L24", "pos": "subject",    "model": "original", "input": "base"}
  },
  "save": [
    {"value": "acts_L8_ans", "model": "original", "input": "base", "file_path": "acts_L8_ans.safetensors"},
    {"value": "acts_L8_sub", "model": "original", "input": "base", "file_path": "acts_L8_sub.safetensors"},
    {"value": "acts_L24_ans", "model": "original", "input": "base", "file_path": "acts_L24_ans.safetensors"},
    {"value": "acts_L24_sub", "model": "original", "input": "base", "file_path": "acts_L24_sub.safetensors"}
  ]
}
