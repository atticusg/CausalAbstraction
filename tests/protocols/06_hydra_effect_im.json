{
  "version": "1",
  "description": "The Hydra effect (McGrath et al. 2023, arXiv:2307.15771), main experiment: resample-ablate attention layer 13 at the final token, measure downstream layers' direct effects (contribution injected as the final residual, read at lm_head) in both the clean and ablated intervened models. Two probe layers written out; a range axis on a single probe site would fan the whole pattern to the paper's grid.",
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main"},
  "data": {
    "base":   {"dataset": "pile/sample", "field": "input"},
    "source": {"dataset": "pile/sample", "field": "resample_input"}
  },
  "sites": {
    "abl":         {"component": "attention_output", "layer": 13},
    "probe14":     {"component": "attention_output", "layer": 14},
    "probe20":     {"component": "attention_output", "layer": 20},
    "resid_final": {"component": "block_output", "layer": 31},
    "lm_head": {"component": "lm_head"}
  },
  "reads": {
    "v_noise":      {"site": "abl",     "pos": -1, "model": "original", "input": "source"},
    "logits_clean": {"site": "lm_head", "pos": -1, "model": "original", "input": "base"},
    "logits_abl":   {"site": "lm_head", "pos": -1, "model": "ablated", "input": "base"},
    "a14_clean":    {"site": "probe14", "pos": -1, "model": "original", "input": "base"},
    "a20_clean":    {"site": "probe20", "pos": -1, "model": "original", "input": "base"},
    "a14_abl":      {"site": "probe14", "pos": -1, "model": "ablated", "input": "base"},
    "a20_abl":      {"site": "probe20", "pos": -1, "model": "ablated", "input": "base"},
    "de14_clean":   {"site": "lm_head", "pos": -1, "model": "with_inj14_clean", "input": "base"},
    "de20_clean":   {"site": "lm_head", "pos": -1, "model": "with_inj20_clean", "input": "base"},
    "de14_abl":     {"site": "lm_head", "pos": -1, "model": "with_inj14_abl", "input": "base"},
    "de20_abl":     {"site": "lm_head", "pos": -1, "model": "with_inj20_abl", "input": "base"}
  },
  "edits": {
    "resample":    {"site": "abl",         "pos": -1, "do": {"swap": "v_noise"}},
    "inj14_clean": {"site": "resid_final", "pos": -1, "do": {"swap": "a14_clean"}},
    "inj20_clean": {"site": "resid_final", "pos": -1, "do": {"swap": "a20_clean"}},
    "inj14_abl":   {"site": "resid_final", "pos": -1, "do": {"swap": "a14_abl"}},
    "inj20_abl":   {"site": "resid_final", "pos": -1, "do": {"swap": "a20_abl"}}
  },
  "intervened_models": {
    "ablated": {"input": "base", "edits": ["resample"]},
    "with_inj14_clean":   {"input": "base", "edits": ["inj14_clean"]},
    "with_inj20_clean":   {"input": "base", "edits": ["inj20_clean"]},
    "with_inj14_abl":   {"input": "base", "edits": ["inj14_abl"]},
    "with_inj20_abl":   {"input": "base", "edits": ["inj20_abl"]}
  },
  "metrics": {
    "te_clean": {"kind": "token_logit", "of": "logits_clean", "token": "ml_token"},
    "te_abl":   {"kind": "token_logit", "of": "logits_abl",   "token": "ml_token"},
    "de14_c":   {"kind": "token_logit", "of": "de14_clean",   "token": "ml_token"},
    "de20_c":   {"kind": "token_logit", "of": "de20_clean",   "token": "ml_token"},
    "de14_a":   {"kind": "token_logit", "of": "de14_abl",     "token": "ml_token"},
    "de20_a":   {"kind": "token_logit", "of": "de20_abl",     "token": "ml_token"}
  },
  "save": [
    {"value": "te_clean", "model": "original", "input": "base", "file_path": "te_clean.parquet"},
    {"value": "te_abl", "model": "ablated", "input": "base", "file_path": "te_abl.parquet"},
    {"value": "de14_c", "model": "with_inj14_clean", "input": "base", "file_path": "de14_clean.parquet"},
    {"value": "de20_c", "model": "with_inj20_clean", "input": "base", "file_path": "de20_clean.parquet"},
    {"value": "de14_a", "model": "with_inj14_abl", "input": "base", "file_path": "de14_abl.parquet"},
    {"value": "de20_a", "model": "with_inj20_abl", "input": "base", "file_path": "de20_abl.parquet"}
  ]
}
