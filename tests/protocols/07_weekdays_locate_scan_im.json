{
  "version": "1",
  "description": "Locate stage as ONE document: interchange scored over a 32-layer x 2-position grid. Axes are explicit {sweep: ...} wrappers on named table entries (sites.target.layer, positions.tap), so every read/write referencing the name moves together. The parser expands 64 points, dedups shared sub-values by content, and plans 64 patched forwards plus one shared counterfactual-harvest forward per row - where CLI multirun ran 64 separate processes, 128 forward groups, 64 model loads.",
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main"},
  "data": {
    "base":   {"dataset": "weekdays/train", "field": "input"},
    "counterfactual": {"dataset": "weekdays/train", "field": "counterfactual_inputs[0]"}
  },
  "positions": {
    "tap": {"sweep": [{"index": -1}, {"variable": "subject"}]}
  },
  "sites": {
    "target": {"component": "block_output", "layer": {"sweep": {"range": [0, 32]}}},
    "lm_head": {"component": "lm_head"}
  },
  "reads": {
    "v_cf":  {"site": "target",  "pos": "tap", "model": "original", "input": "counterfactual"},
    "logits": {"site": "lm_head", "pos": -1,    "model": "patched", "input": "base"}
  },
  "writes": {
    "patch": {"site": "target", "pos": "tap", "do": {"swap": "v_cf"}}
  },
  "intervened_models": {
    "patched": {"input": "base", "writes": ["patch"]}
  },
  "metrics": {
    "iia":        {"kind": "match",      "of": "logits", "expected": "cf_answer", "token_form": "space_prefixed"},
    "logit_diff": {"kind": "logit_diff", "of": "logits", "a": "cf_answer", "b": "base_answer", "token_form": "space_prefixed"}
  },
  "save": [
    {"value": "iia", "model": "patched", "input": "base", "file_path": "iia.json"},
    {"value": "logit_diff", "model": "patched", "input": "base", "file_path": "logit_diff.json"}
  ]
}
