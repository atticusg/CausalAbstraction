{
  "version": "1",
  "description": "Chat-coherent drift tier, point document (successor to the retired Qwen golden tier): weekday-successor task on Qwen3-4B in raw completion form (protocol v1 has no chat-template path - a recorded fidelity gap vs the old tier). Pins: baseline accuracy (gated >= 0.9 like the old tier), IIA and logit_diff under an interchange at layer 26 (where the MPS scout run localizes Qwen3-4B's last-token binding signal - layers <= 22 give IIA 0), and tensor statistics of the harvested residual. Values are captured on the canonical GPU by tests/golden/drift/update_drift_goldens.py, never asserted from papers.",
  "model": {"key": "Qwen/Qwen3-4B-Instruct-2507", "revision": "main"},
  "data": {
    "base":   {"dataset": "drift/weekdays", "field": "input"},
    "source": {"dataset": "drift/weekdays", "field": "counterfactual_inputs[0]"}
  },
  "sites": {
    "target": {"component": "block_output", "layer": 26},
    "lm_head": {"component": "lm_head"}
  },
  "reads": {
    "v_src":         {"site": "target",  "pos": -1, "model": "original", "input": "source"},
    "acts_mid":      {"site": "target",  "pos": -1, "model": "original", "input": "base"},
    "logits_clean":  {"site": "lm_head", "pos": -1, "model": "original", "input": "base"},
    "logits_patched": {"site": "lm_head", "pos": -1, "model": "patched", "input": "base"}
  },
  "edits": {
    "patch": {"site": "target", "pos": -1, "do": {"swap": "v_src"}}
  },
  "intervened_models": {
    "patched": {"input": "base", "edits": ["patch"]}
  },
  "metrics": {
    "acc": {"kind": "match", "of": "logits_clean", "expected": "answer"},
    "iia": {"kind": "match", "of": "logits_patched", "expected": "cf_answer"},
    "ld":  {"kind": "logit_diff", "of": "logits_patched", "a": "cf_answer", "b": "answer"}
  },
  "save": [
    {"value": "acc", "model": "original", "input": "base", "file_path": "acc.parquet"},
    {"value": "iia", "model": "patched", "input": "base", "file_path": "iia.parquet"},
    {"value": "ld", "model": "patched", "input": "base", "file_path": "ld.parquet"},
    {"value": "acts_mid", "model": "original", "input": "base", "file_path": "acts_mid.safetensors"}
  ]
}
