{
  "version": "1",
  "description": "Step 4 / the core test: swap the answer-slot residual stream from the counterfactual into the base at one mid-tower layer, and score IIA. This is configs/protocols/interchange.json retargeted - only model.key and sites.target.layer differ.",
  "model": {
    "key": "Qwen/Qwen3.6-35B-A3B",
    "revision": "main",
    "dtype": "bf16"
  },
  "data": {
    "base": {
      "dataset": "weekdays/train",
      "field": "input"
    },
    "counterfactual": {
      "dataset": "weekdays/train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "sites": {
    "target": {
      "component": "block_output",
      "layer": 20
    },
    "lm_head": {
      "component": "lm_head"
    }
  },
  "reads": {
    "v_cf": {
      "site": "target",
      "pos": -1,
      "model": "original",
      "input": "counterfactual"
    },
    "logits": {
      "site": "lm_head",
      "pos": -1,
      "model": "patched",
      "input": "base"
    }
  },
  "writes": {
    "patch": {
      "site": "target",
      "pos": -1,
      "do": {
        "swap": "v_cf"
      }
    }
  },
  "intervened_models": {
    "patched": {
      "input": "base",
      "writes": [
        "patch"
      ]
    }
  },
  "metrics": {
    "iia": {
      "kind": "match",
      "of": "logits",
      "expected": "cf_answer",
      "token_form": "space_prefixed"
    },
    "logit_diff": {
      "kind": "logit_diff",
      "of": "logits",
      "a": "cf_answer",
      "b": "base_answer",
      "token_form": "space_prefixed"
    }
  },
  "save": [
    {
      "value": "iia",
      "model": "patched",
      "input": "base",
      "file_path": "iia.json"
    },
    {
      "value": "logit_diff",
      "model": "patched",
      "input": "base",
      "file_path": "logit_diff.json"
    }
  ]
}
