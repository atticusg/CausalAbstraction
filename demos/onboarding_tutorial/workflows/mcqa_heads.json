{
  "version": "1",
  "description": "The 08_attention demo end to end: interchange every head's pattern, draw the (layer x head) grid, summarize each head with a mean and a spread, and name the one head the grid picks. head_stats reads the same per-example table the heatmap does, so the ranking and the picture cannot disagree; it is told which columns hold the layer and the head, because its defaults name a site called 'target' and this document's site is called 'pattern'.",
  "output_dir": "mcqa_heads",
  "steps": {
    "scan": {
      "type": "intervention_protocol",
      "document": "../protocols/mcqa_head_scan.json"
    },
    "grid": {
      "type": "script",
      "script": {
        "module": "causalab.io.plots.workflow_figures"
      },
      "inputs": {
        "table": {
          "step": "scan",
          "file": "iia.json"
        },
        "plot": "heatmap",
        "x": "sites.pattern.layer",
        "y": "sites.pattern.head"
      },
      "outputs": {
        "figure": "head_iia.png",
        "plotted": {
          "file": "head_iia.json"
        }
      }
    },
    "per_head": {
      "type": "script",
      "script": {
        "module": "causalab.analysis.head_stats"
      },
      "inputs": {
        "table": {
          "step": "scan",
          "file": "iia.json"
        },
        "layer_column": "sites.pattern.layer",
        "head_column": "sites.pattern.head"
      },
      "outputs": {
        "stats": {
          "file": "head_stats.json",
          "columns": {
            "layer": "int64",
            "head": "int64",
            "n": "int64",
            "mean": "float64",
            "std": "float64"
          }
        }
      }
    },
    "best": {
      "type": "script",
      "script": {
        "module": "causalab.workflow.scripts.select"
      },
      "inputs": {
        "table": {
          "step": "scan",
          "file": "iia.json"
        },
        "choose": "max",
        "emit": {
          "best_layer": "sites.pattern.layer",
          "best_head": "sites.pattern.head"
        }
      },
      "outputs": {
        "values": {
          "file": "values.json",
          "keys": {
            "best_layer": 14,
            "best_head": 11
          }
        }
      }
    }
  }
}
