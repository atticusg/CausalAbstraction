# Copy to .env at the repo root and fill in your keys.
#
# .env is gitignored. The experiment runner auto-loads it at entry
# (causalab.runner.env.load_project_dotenv), so no manual `export` / `source`
# is needed — including SLURM jobs, which read the same shared-FS .env.
#
# Use the canonical KEY=value form (NO spaces around `=`) so the file stays
# POSIX-sourceable (`set -a; . .env`) as well as dotenv-parseable.

# LLM judge used by analyses that call the judge (default provider: openrouter).
OPENROUTER_API_KEY=sk-or-your-key-here

# Only needed if you set judge.provider=openai.
# OPENAI_API_KEY=sk-your-key-here
